# FinPulse AI - Environment Variables Template
# Copy this file to `.env.local` and fill in your custom API credentials before starting.

# Supabase Authentication & Database Configuration (Get yours at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini LLM API Key (Get yours at ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Llama LLM API Key (Get yours at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Get yours at openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# HuggingFace API Key (Optional fallback)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Cohere Rerank API Key (Optional fallback)
COHERE_API_KEY=your_cohere_api_key_here

# Finnhub Company News API Key (Get yours at finnhub.io)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage Market Fundamentals Key (Get yours at alphavantage.co)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Optional: Resend API Key for automated market briefs email delivery (resend.com)
# RESEND_API_KEY=your_resend_api_key_here

# Optional: FRED API Key for international macroeconomics metrics (fred.stlouisfed.org)
# FRED_API_KEY=your_fred_api_key_here
